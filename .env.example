# ===== 复制本文件为 .env 后填写，.env 不会提交到 Git =====
# 使用方式（Git Bash）：
#   cp .env.example .env
# 然后在 IDEA 的 Run Configuration 里读取，或用 docker-compose env_file 注入。

# MySQL 连接（本机 MySQL 8 在 D:\mysql\mysql-8.0.27-winx64）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=recommend_db
DB_USERNAME=root
DB_PASSWORD=请填写你的MySQL口令

# JWT 密钥：HS256 要求至少 32 字节，请替换为随机串
# 生成方式：openssl rand -base64 48
JWT_SECRET=请替换为至少32位的随机字符串
