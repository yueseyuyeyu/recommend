# ===== Java / Maven =====
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
*.war
*.ear

# ===== IDE =====
.idea/
# IDEA 共享运行配置目录（勾选 Store as project file 时生成，可能含明文环境变量）
.run/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
bin/
.vscode/
*.swp

# ===== Node / 前端 =====
node_modules/
dist/
dist-ssr/
*.local
.webcache
.vite/
coverage/

# ===== 日志 =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== 环境变量与密钥 =====
# 绝不允许提交：真实数据库口令、JWT 密钥、任何个人配置
.env
.env.*
!.env.example
application-secret.yml
# 本地个人配置覆盖文件（每人一份，不入库）
*local.yml
*local.yaml
*.pem
*.key

# ===== 数据库本地文件 =====
*.db
*.sqlite
*.sqlite3
# 数据库导出的真实数据快照（体积大且可能含真实信息）
*_dump.sql
*_backup.sql

# ===== 系统 =====
.DS_Store
Thumbs.db
desktop.ini
*.orig
*.rej
